# Build
/build/bin/
*.exe
*.syso

# Frontend
/frontend/node_modules/
# The directory has to exist even when empty: main.go embeds it with //go:embed
/frontend/dist/*
!/frontend/dist/.gitkeep

# Generated mockup preview (the .dc.html sources are versioned)
/design/networkprofile-ecrans.html

# JS bindings, regenerated by wails on every build
/frontend/wailsjs/go/

# Cache fingerprint written by wails
/frontend/package.json.md5

# Machine-local Claude Code settings
/.claude/settings.local.json
